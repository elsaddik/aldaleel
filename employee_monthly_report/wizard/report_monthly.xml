<odoo>
    <template id="report_monthly_template">
        <t t-call="web.html_container">

            <style>
                @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&amp;display=swap');

                .page_rtl {
                    direction: rtl !important;
                    text-align: right !important;
                    font-family: 'Cairo', sans-serif !important;
                    font-size: 13px;
                }

                .table_rtl {
                    direction: rtl !important;
                    width: 100%;
                    border-collapse: collapse;
                    text-align: center !important;
                }

                .custom-header {
                    background-color: #1a237e !important;
                    color: #ffffff !important;
                }

                .custom-header th {
                    border: 1px solid #000000 !important;
                    padding: 10px !important;
                }

                tr { page-break-inside: avoid; }
            </style>

            <t t-call="web.external_layout">

                <div class="page page_rtl" style="direction:rtl;">

                    <t t-if="docs">
                        <t t-foreach="docs" t-as="doc">

                            <!-- صفحة لكل موظف -->
                            <div class="employee_block"
                                 style="page-break-after: always; padding-top: 20px;">

                                <!-- Header -->
                                <div class="text-center">
                                    <h3 style="color:#1a237e; font-weight:bold; border-bottom:2px solid #1a237e; display:inline-block;">
                                        التقرير الشهري للموظف
                                    </h3>

                                    <h4 class="mt-3">
                                        <t t-esc="doc['employee'].name"/>
                                    </h4>

                                    <p class="text-muted">
                                        من:
                                        <t t-esc="date_from"/>
                                        |
                                        إلى:
                                        <t t-esc="date_to"/>
                                    </p>
                                </div>

                                <!-- Table -->
                                <table class="table table-bordered table_rtl text-center mt-4">

                                    <thead class="custom-header text-center" >
                                        <tr>
                                            <th style="text-align: center !important; vertical-align: middle !important;">عدد الإنذارات</th>
                                            <th style="text-align: center !important; vertical-align: middle !important;">الإجازات</th>
                                            <th style="text-align: center !important; vertical-align: middle !important;">مرات التأخير</th>
                                            <th style="text-align: center !important; vertical-align: middle !important;">الأذونات</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr>
                                            <td><t t-esc="doc['alerts']"/></td>
                                            <td><t t-esc="doc['leaves']"/></td>
                                            <td><t t-esc="doc['late']"/></td>
                                            <td><t t-esc="doc['permissions']"/></td>
                                        </tr>
                                    </tbody>

                                </table>

                            </div>

                        </t>
                    </t>

                    <t t-else="">
                        <div class="alert alert-info text-center mt-5">
                            لا توجد بيانات
                        </div>
                    </t>

                </div>
            </t>
        </t>
    </template>
</odoo>