<odoo>

    <record id="view_employee_alert_form" model="ir.ui.view">
        <field name="name">employee.alert.form</field>
        <field name="model">employee.alert</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="message"/>
                        <field name="employee_id"/>
                        <field name="department_id"/>

                        <field name="date"/>
                    </group>


                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_employee_alert_list" model="ir.ui.view">
        <field name="name">employee.alert.list</field>
        <field name="model">employee.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>

                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="action_employee_alert" model="ir.actions.act_window">
        <field name="name">Employee Alerts</field>
        <field name="res_model">employee.alert</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_employee_alert_root" name="Employee Alerts"/>
    <menuitem id="menu_employee_alert"
              name="Alerts"
              parent="menu_employee_alert_root"
              action="action_employee_alert"/>

</odoo>