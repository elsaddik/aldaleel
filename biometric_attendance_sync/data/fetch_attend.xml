<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="ir_cron_fetch_attendance_middleware" model="ir.cron">
            <field name="name">Attendance: Fetch from Middleware Server</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.fetch_attendance_from_middleware()</field>
            <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>


    <record id="ir_cron_auto_close_attendance" model="ir.cron">
    <field name="name">Auto Close Attendance</field>
    <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
    <field name="state">code</field>
    <field name="code">model.auto_close_open_attendance()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>

    <field name="active">False</field>


</record>

</odoo>