<odoo>

    <record id="view_monthly_report_wizard_form" model="ir.ui.view">
        <field name="name">monthly.report.wizard.form</field>
        <field name="model">monthly.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly Employee Report">

                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <footer>
                    <button name="action_print_report"
                            type="object"
                            string="Print Report"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>


    <record id="action_server_monthly_report" model="ir.actions.server">
        <field name="name">Monthly Report</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>

        <field name="code">
            action = {
            'type': 'ir.actions.act_window',
            'name': 'Monthly Report',
            'res_model': 'monthly.report.wizard',
            'view_mode': 'form',
            'target': 'new',
            'context': {
            'active_ids': records.ids
            }
            }
        </field>

    </record>

</odoo>

